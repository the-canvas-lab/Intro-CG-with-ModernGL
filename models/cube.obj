# cube.obj -- unit cube centered at the origin (-0.5 to +0.5 on each axis)
#
# 8 positions, 4 UV corners (shared across all faces), 6 face normals.
# All faces are triangulated; pywavefront reads this as T2F_N3F_V3F:
#   u v  nx ny nz  x y z   (8 floats per vertex)

# vertex positions
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# texture coordinates (four corners of [0,1]^2)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# face normals (one per axis direction)
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# back face  (z = -0.5,  n = 0 0 -1)
f 1/1/1 2/2/1 3/3/1
f 3/3/1 4/4/1 1/1/1

# front face  (z = +0.5,  n = 0 0 +1)
f 5/1/2 6/2/2 7/3/2
f 7/3/2 8/4/2 5/1/2

# left face  (x = -0.5,  n = -1 0 0)
f 8/2/3 4/3/3 1/4/3
f 1/4/3 5/1/3 8/2/3

# right face  (x = +0.5,  n = +1 0 0)
f 7/2/4 3/3/4 2/4/4
f 2/4/4 6/1/4 7/2/4

# bottom face  (y = -0.5,  n = 0 -1 0)
f 1/4/5 2/3/5 6/2/5
f 6/2/5 5/1/5 1/4/5

# top face  (y = +0.5,  n = 0 +1 0)
f 4/4/6 3/3/6 7/2/6
f 7/2/6 8/1/6 4/4/6
